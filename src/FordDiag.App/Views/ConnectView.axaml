<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FordDiag.App.ViewModels" xmlns:s="using:FordDiag.App.Services" xmlns:core="using:FordDiag.Core"
             x:Class="FordDiag.App.Views.ConnectView" x:DataType="vm:ConnectViewModel">
    <ScrollViewer>
        <StackPanel Margin="32 28" Spacing="20" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Connect to the vehicle" />
                <TextBlock Classes="muted" Text="{Binding ConnectedHint}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="h2" Text="Adapter" />
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="Interface" />
                            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding Adapter}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="core:FordAdapter"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="caption" Text="{Binding AdapterNotes}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="Serial port or host:port (Wi-Fi)" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <AutoCompleteBox Text="{Binding Port}" ItemsSource="{Binding Ports}" MinimumPrefixLength="0" PlaceholderText="/dev/ttyUSB0, COM3, 192.168.0.10:35000" />
                                <Button Grid.Column="1" Command="{Binding RefreshPortsCommand}" ToolTip.Tip="Rescan ports"><PathIcon Data="{x:Static s:Icons.Refresh}" Width="14" Height="14" /></Button>
                            </Grid>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding UseSimulator}" Content="Use built-in vehicle simulator (no hardware needed)" />
                        <Border Classes="banner bad" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Classes="accent" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" Content="Connect" />
                            <Button Classes="plain" Command="{Binding DisconnectCommand}" IsEnabled="{Binding CanDisconnect}" Content="Disconnect" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="h2" Text="Bus access" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="14">
                            <Border Classes="pill info"><TextBlock Text="HS-CAN" FontWeight="SemiBold" FontSize="12" /></Border>
                            <TextBlock Grid.Column="1" Text="500 kbit/s · OBD pins 6 / 14 · engine, transmission, ABS" Classes="muted" TextWrapping="Wrap" />
                            <Border Grid.Row="1" Classes="pill info"><TextBlock Text="MS-CAN" FontWeight="SemiBold" FontSize="12" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="125 kbit/s · OBD pins 3 / 11 · body, cluster, audio, HVAC" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SwitchingText}" TextWrapping="Wrap" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="caption" Text="Battery" />
                                <TextBlock Text="{Binding State.VoltageText}" Classes="big" />
                                <TextBlock Text="{Binding VoltageHint}" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RefreshVoltageCommand}" IsEnabled="{Binding CanDisconnect}" VerticalAlignment="Top" Content="Read" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="banner">
                <StackPanel Spacing="4">
                    <TextBlock Text="Before you start" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Text="Reading data is safe. Coding and clearing codes can permanently damage a module if interrupted. Use a battery maintainer, keep the ignition on and never write something you cannot restore from a backup." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
