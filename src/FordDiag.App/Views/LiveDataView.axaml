<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FordDiag.App.ViewModels" xmlns:s="using:FordDiag.App.Services" xmlns:live="using:FordDiag.Core.Live"
             x:Class="FordDiag.App.Views.LiveDataView" x:DataType="vm:LiveDataViewModel">
    <Grid RowDefinitions="Auto,*" Margin="32 28 32 24" RowSpacing="16">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsStandard}">
                <TextBlock Classes="muted" Text="{Binding Rate}" VerticalAlignment="Center" />
                <Button Classes="accent" Command="{Binding StartCommand}" IsVisible="{Binding IsStopped}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{x:Static s:Icons.Play}" Width="14" Height="14" /><TextBlock Text="Start" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{x:Static s:Icons.Stop}" Width="14" Height="14" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsEnhanced}">
                <TextBlock Classes="muted" Text="{Binding Enhanced.Rate}" VerticalAlignment="Center" />
                <Button Classes="accent" Command="{Binding Enhanced.StartCommand}" IsVisible="{Binding Enhanced.IsStopped}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{x:Static s:Icons.Play}" Width="14" Height="14" /><TextBlock Text="Start" /></StackPanel>
                </Button>
                <Button Classes="plain" Command="{Binding Enhanced.StopCommand}" IsVisible="{Binding Enhanced.IsRunning}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{x:Static s:Icons.Stop}" Width="14" Height="14" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Classes="h1" Text="Live data" />
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <ToggleButton Content="Standard OBD-II" IsChecked="{Binding IsStandard, Mode=OneWay}" Command="{Binding ShowStandardCommand}" CornerRadius="8 0 0 8" Padding="14 6" />
                    <ToggleButton Content="Ford module data" IsChecked="{Binding IsEnhanced, Mode=OneWay}" Command="{Binding ShowEnhancedCommand}" CornerRadius="0 8 8 0" Padding="14 6" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- standard mode -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsStandard}" RowSpacing="10">
            <TextBlock Classes="muted" Text="{Binding Hint}" />
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LiveTile">
                            <Border Classes="card" Width="226" Margin="0 0 14 14" Padding="16 14">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="big mono" Text="{Binding ValueText}" />
                                        <TextBlock Classes="muted" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="0 0 0 6" />
                                    </StackPanel>
                                    <Polyline Points="{Binding Points}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" Width="190" Height="34" HorizontalAlignment="Left" Margin="0 4 0 0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Ford module data -->
        <Grid Grid.Row="1" ColumnDefinitions="400,*" ColumnSpacing="16" IsVisible="{Binding IsEnhanced}" x:DataType="vm:LiveDataViewModel">
            <Border Classes="card" Padding="0" ClipToBounds="True" DataContext="{Binding Enhanced}" x:CompileBindings="False">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Margin="14 12 14 8" Spacing="8">
                        <ComboBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" HorizontalAlignment="Stretch" />
                        <TextBlock Classes="caption" Text="{Binding SetHint}" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding ModuleChoices}" SelectedItem="{Binding SelectedModule}" HorizontalAlignment="Stretch" PlaceholderText="Module" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Search}" PlaceholderText="Search values" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding IncludeExperimental}" Content="Experimental" ToolTip.Tip="Values the source project has not verified yet" />
                        </Grid>
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}" />
                    <ListBox Grid.Row="2" Classes="rows" ItemsSource="{Binding Signals}" SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnhancedSignalViewModel">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="14 2" MinHeight="46">
                                    <StackPanel Spacing="0" Margin="4 4">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Classes="caption" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Group}" /><Run Text="  ·  " /><Run Text="{Binding Request}" /><Run Text="  " /><Run Text="{Binding Unit}" />
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Classes="caption" Margin="14 8" TextWrapping="Wrap" Text="{Binding Attribution}" MaxHeight="48" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" DataContext="{Binding Enhanced}" x:CompileBindings="False" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="muted" Text="{Binding Hint}" VerticalAlignment="Center" />
                    <Button Classes="plain" Command="{Binding ClearSelectionCommand}" Content="Clear selection" IsVisible="{Binding SelectedCount}" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Tiles}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnhancedTile">
                                <Border Classes="card" Width="226" Margin="0 0 14 14" Padding="16 14">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="caption" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Classes="pill" Padding="6 0"><TextBlock Text="{Binding Module}" FontSize="10" FontWeight="SemiBold" /></Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="big mono" Text="{Binding ValueText}" FontSize="24" />
                                            <TextBlock Classes="muted" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="0 0 0 4" />
                                        </StackPanel>
                                        <Polyline Points="{Binding Points}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeJoin="Round" Width="190" Height="34" HorizontalAlignment="Left" Margin="0 4 0 0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
